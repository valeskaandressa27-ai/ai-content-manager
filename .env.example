# Copie para .env e preencha. NUNCA versione o arquivo .env.
# Gerar SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# development | production   (em production, SECRET_KEY e DATABASE_URL são obrigatórias)
ENVIRONMENT=development

# PostgreSQL. Aceita postgres://... ou postgresql://... (o app adapta para o driver).
# Sem Docker, exemplo local: postgresql://usuario:senha@localhost:5432/ai_content_manager
# Com Docker Compose o valor é definido automaticamente pelo docker-compose.yml.
DATABASE_URL=

# Chave para assinar os JWTs (mínimo 32 caracteres em produção).
SECRET_KEY=

# Origens permitidas no CORS, separadas por vírgula. Em produção (mesma origem) pode ficar
# com a URL do próprio serviço. Nunca use * em produção.
CORS_ORIGINS=http://localhost:4200

# Provedor de IA compatível com a API de chat completions (OpenAI, Groq, OpenRouter, Gemini...).
# AI_API_URL é o endpoint COMPLETO, ex.: https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_API_URL=
AI_MODEL=

# Limite de gerações de IA por usuário por dia (regenerar conta como nova geração).
AI_DAILY_GENERATION_LIMIT=20

# Opcionais
AI_TIMEOUT_SECONDS=30
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Fuso usado para "virar o dia" do limite diário.
USAGE_TIMEZONE=America/Sao_Paulo
# Porta do host no Docker Compose local.
APP_PORT=8000
